modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3001

[[ports]]
localPort = 23637
externalPort = 3002

[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["npm", "run", "build"]

# SPA fallback: this is a client-side-routed React app (react-router), so a
# direct visit or refresh on any deep route (e.g. /about/hubs/health) must
# still resolve to index.html for the client router to take over. Real files
# (JS/CSS/images) take precedence over this rewrite per Replit's own rules,
# and the app's own NotFound.tsx still handles routes react-router doesn't
# recognize — this rewrite only gets requests to the SPA shell, nothing more.
[[deployment.rewrites]]
from = "/*"
to = "/index.html"
